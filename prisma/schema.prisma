generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum LeadStatus {
  NEW
  CONTACTED
  DISCUSSION
  WON
  LOST
}

enum StoryType {
  CONCEPT
  PROCESS
  FINAL
}

enum Role {
  ADMIN
  EDITOR
}

model Project {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  category String // Residential | Interiors | Institutional | Commercial | Hospitality
  year     Int?
  location String?
  typology String?
  // `area` is the built-up figure (what the site has always shown);
  // `siteArea` is the plot, which the client's data sheet lists separately.
  area     String?
  siteArea String?
  team     String?
  // Credits straight off the client's project sheet.
  client       String?
  photographer String?
  collaborator String? // e.g. "In association with Studio Parametric"
  units        String? // e.g. "55 villaments", "15 units"
  statusNote   String? // e.g. "Completed in 2023", "Construction phase"
  heroImage    String?
  heroBlur    String?
  gallery     GalleryImage[]
  storyBlocks StoryBlock[]
  status      ProjectStatus  @default(DRAFT)
  order       Int            @default(0)
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, order])
}

model GalleryImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  blurData  String?
  order     Int     @default(0)

  @@index([projectId, order])
}

model StoryBlock {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      StoryType
  text      String?
  image     String?
  order     Int       @default(0)

  @@index([projectId, order])
}

/// Client testimonials — seeded from the studio's Google reviews and
/// curated from the dashboard. `featured` rows appear on the home page;
/// `published` rows appear on /testimonials. `googleId` is the dedupe
/// key for the Places-API sync, so re-syncing never duplicates a review.
model Testimonial {
  id         String   @id @default(cuid())
  author     String
  context    String? // e.g. "Private residence" — shown under the name
  rating     Int      @default(5)
  text       String // the full review, verbatim
  excerpt    String? // shorter cut for the home page; blank = use text
  source     String   @default("manual") // "google" | "manual"
  sourceDate String? // display label, e.g. "June 2026"
  googleId   String?  @unique
  featured   Boolean  @default(false)
  published  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, order])
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  source    String? // page path / project slug / campaign
  topic     String? // project type chip from the enquiry form
  budget    String? // budget range chip — discovery form asked to capture
  location  String? // site location — discovery form asked to capture
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())

  @@index([status])
  @@index([createdAt])
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  cover       String?
  coverBlur   String?
  body        Json // rich block content
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

/// Editable site copy + studio identity, one row per page section
/// ("identity", "home", "about", "services", "contact"). Values are JSON
/// so a section can grow new fields without a migration; `lib/settings.ts`
/// merges each row over a typed default, so a missing row still renders.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  lastLogin    DateTime?
}

// First-party privacy-friendly analytics: no cookies, no PII, no external JS.
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  source    String? // utm_source / campaign attribution
  country   String? // from Cloudflare CF-IPCountry header
  device    String? // mobile | desktop (coarse, from UA)
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}
