     "order": 0
    },
    {
     "id": "cmras2f5l0008ywtd6dsphxqm",
     "projectId": "cmr5527fq0006wktd6da6wsf1",
     "type": "FINAL",
     "text": "The false ceiling stays quiet and elegant with veneered ply borders, and the corridor becomes a gallery for the art collection. Each bedroom follows the client's brief — a purple theme for the daughter, a subtly accented guest room, and a blue-themed master with rich panelling.",
     "image": null,
     "order": 1
