   "storyBlocks": [
    {
     "id": "cmras2f5a0004ywtdrkxzf9ky",
     "projectId": "cmr5527fb0003wktdbmfj858y",
     "type": "CONCEPT",
     "text": "A dense neighbourhood, a modest 45'×45' plot, and a brief that asked for a lift and a comfortable staircase. The design segregates vertical circulation to the south-east corner and opens the living and bedroom areas to the north-facing road for light and ventilation. A laser-cut Fundermax screen becomes the façade's defining element — privacy from the busy road — while stepped terraces add breakout green space at every level.",
     "image": null,
     "order": 0
    },
    {
     "id": "cmras2f5b0005ywtdv9akg3di",
     "projectId": "cmr5527fb0003wktdbmfj858y",
     "type": "FINAL",
     "text": "Humble tones of beige merge with rustic walnut as warm light seeps in through every niche. Minimal panels patterned on tree bark and foliage wrap the spaces, and intricately detailed apertures mimic vegetation — a play of light and shadow that makes moving through the house an immersive experience.",
     "image": null,
     "order": 1
    }
   ]
  },
