# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded media is committed (13 MB today) so Vercel/GitHub deploys
# ship the photography; revisit if the library outgrows git

# generated prisma client (rebuilt via postinstall)
/lib/generated/

# client discovery data (not code)
*.csv

# Raw asset drops from the client (photo folders arrive as Drive exports).
# The optimised output under public/uploads/ is what gets committed — the
# archive itself is tens of megabytes of originals and belongs on disk.
*.zip
